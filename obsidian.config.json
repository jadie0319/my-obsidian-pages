{
  "source": "./vault",
  "output": "./dist",
  "exclude": [
    ".obsidian",
    ".trash"
  ],
  "basePath": "/my-obsidian-pages/",
  "template": "default",
  "site": {
    "title": "Jadie Blog",
    "description": "My notes published from Obsidian",
    "author": "",
    "url": "https://jadie0319.github.io/my-obsidian-pages"
  },
  "markdown": {
    "preserveWikiLinks": false,
    "convertCallouts": true,
    "syntaxHighlighting": true
  },
  "features": {
    "generateIndex": true,
    "generateSitemap": true,
    "copyAssets": true
  },
  "publishing": {
    "language": "ko",
    "homeOrder": [
      "intro",
      "recent",
      "topics",
      "graph"
    ],
    "search": true,
    "previews": true,
    "localGraph": true,
    "rss": true,
    "checkLinks": true,
    "strictLinks": true
  }
}
